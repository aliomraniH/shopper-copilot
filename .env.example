# ============================================
# Environment Variables Configuration Template
# ============================================
#
# 🚨 IMPORTANT: This is just a TEMPLATE!
#
# The actual `.env` file is NOT in the repository
# (it's in `.gitignore` for security reasons).
#
# YOU MUST CREATE YOUR OWN `.env` FILE!

# ============================================
# 📝 Quick Setup Instructions
# ============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit the new .env file:
#    nano .env
#    OR
#    code .env
#    OR
#    open .env
#
# 3. Replace the placeholder values below with your actual values

# ============================================
# OpenAI API Configuration (server.js)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# The key starts with: sk-proj-... or sk-...
# NOTE: OpenAI requires billing/credit card

OPENAI_API_KEY=your-actual-openai-api-key-here

# ============================================
# Google Gemini API Configuration (server-gemini.js)
# ============================================
# Get your FREE API key from: https://aistudio.google.com/apikey
# The key starts with: AIza...
# FREE tier: 60 requests/minute, 1,500/day
# No credit card required!

GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Google Drive API Configuration (server-drive.js)
# ============================================
# Option 1: API Key (for public files/folders only)
# Get from: https://console.cloud.google.com/apis/credentials
# The key starts with: AIza...

GOOGLE_API_KEY=your-google-api-key-here

# Option 2: OAuth 2.0 (for private files/folders - more secure)
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID credentials

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=your-refresh-token

# ============================================
# Server Configuration
# ============================================

PORT=3000
NODE_ENV=development

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# For development, allow localhost

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================
# ⚠️ Common Errors and Solutions
# ============================================
#
# Error: "OPENAI_API_KEY environment variable is missing or empty"
# Solution: You didn't create the .env file! Run: cp .env.example .env
#
# Error: "Failed to generate summary" / Connection errors (OpenAI)
# Solution: Check your API key is valid at https://platform.openai.com/api-keys
#
# Error: "403 Forbidden" (Gemini)
# Solution: Get a new API key from https://aistudio.google.com/apikey
#          Make sure "Generative Language API" is enabled
#
# Error: Server won't start
# Solution: Make sure you saved the .env file after editing it

# ============================================
# 🔒 Security Notes
# ============================================
#
# ✅ .env is in .gitignore - it will NEVER be committed
# ✅ Never share your .env file or API keys
# ✅ Each developer needs their own .env file
# ✅ If you expose your key, rotate it immediately at OpenAI dashboard

# ============================================
# 🌍 Environment-Specific Settings
# ============================================
#
# For Production (Replit/Heroku/etc):
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com
#
# For Replit:
# Don't create .env file - use Secrets tab instead
# Add each variable as a secret in Replit UI

# ============================================
# ✅ Verify Your Setup
# ============================================
#
# After creating .env, start the server:
#   npm start
#
# You should see:
#   ╔════════════════════════════════════╗
#   ║  OpenAI: ✓ Configured              ║
#   ╚════════════════════════════════════╝
