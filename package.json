{
  "name": "shopper-copilot",
  "version": "1.0.0",
  "description": "AI-powered shopping assistant browser extension",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:gemini": "node server-gemini.js",
    "start:drive": "node server-drive.js",
    "dev": "nodemon server.js",
    "dev:gemini": "nodemon server-gemini.js",
    "dev:drive": "nodemon server-drive.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:drive": "node test-drive-fetch.js",
    "prepare": "husky install"
  },
  "keywords": [
    "shopping",
    "ai",
    "browser-extension",
    "chatbot",
    "openai"
  ],
  "author": "Shopper Copilot Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^166.0.0",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
