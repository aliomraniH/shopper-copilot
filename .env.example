# ============================================
# Environment Variables Configuration Template
# ============================================
#
# 🚨 IMPORTANT: This is just a TEMPLATE!
#
# The actual `.env` file is NOT in the repository
# (it's in `.gitignore` for security reasons).
#
# YOU MUST CREATE YOUR OWN `.env` FILE!

# ============================================
# 📝 Quick Setup Instructions
# ============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit the new .env file:
#    nano .env
#    OR
#    code .env
#    OR
#    open .env
#
# 3. Replace the placeholder values below with your actual values

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# The key starts with: sk-proj-... or sk-...

OPENAI_API_KEY=your-actual-openai-api-key-here

# ============================================
# Server Configuration
# ============================================

PORT=3000
NODE_ENV=development

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# For development, allow localhost

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================
# ⚠️ Common Errors and Solutions
# ============================================
#
# Error: "OPENAI_API_KEY environment variable is missing or empty"
# Solution: You didn't create the .env file! Run: cp .env.example .env
#
# Error: "Failed to generate summary" / Connection errors
# Solution: Check your API key is valid at https://platform.openai.com/api-keys
#
# Error: Server won't start
# Solution: Make sure you saved the .env file after editing it

# ============================================
# 🔒 Security Notes
# ============================================
#
# ✅ .env is in .gitignore - it will NEVER be committed
# ✅ Never share your .env file or API keys
# ✅ Each developer needs their own .env file
# ✅ If you expose your key, rotate it immediately at OpenAI dashboard

# ============================================
# 🌍 Environment-Specific Settings
# ============================================
#
# For Production (Replit/Heroku/etc):
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com
#
# For Replit:
# Don't create .env file - use Secrets tab instead
# Add each variable as a secret in Replit UI

# ============================================
# ✅ Verify Your Setup
# ============================================
#
# After creating .env, start the server:
#   npm start
#
# You should see:
#   ╔════════════════════════════════════╗
#   ║  OpenAI: ✓ Configured              ║
#   ╚════════════════════════════════════╝
